# Development Dockerfile для frontend с hot reload
FROM node:20-alpine

WORKDIR /app

# Копируем только package.json для установки зависимостей
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем остальные файлы (но они будут перезаписаны volume mount)
COPY . .

# Открываем порт для Next.js dev server
EXPOSE 3000

# Запускаем dev server с hot reload
CMD ["npm", "run", "dev"]
